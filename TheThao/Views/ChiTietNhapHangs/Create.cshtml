@model TheThao.Models.ChiTietNhapHang

@{
    ViewData["Title"] = "Create";
    Layout = "ExAdm";
}

<h1>Create</h1>

<h4>ChiTietNhapHang</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" id="createForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MaSanPham" class="control-label"></label>
                <select asp-for="MaSanPham" class="form-control" asp-items="ViewBag.MaSanPham"></select>
            </div>
            <div class="form-group">
                <label asp-for="MaNhapHang" class="control-label"></label>
                <select asp-for="MaNhapHang" class="form-control" asp-items="ViewBag.MaNhapHang"></select>
            </div>
            <div class="form-group">
                <label asp-for="MaNhaCungCap" class="control-label"></label>
                <select asp-for="MaNhaCungCap" class="form-control" asp-items="ViewBag.MaNhaCungCap"></select>
            </div>
            <div class="form-group">
                <label asp-for="SoLuongNhap" class="control-label"></label>
                <input asp-for="SoLuongNhap" class="form-control" id="SoLuongNhap" />
                <span asp-validation-for="SoLuongNhap" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gia" class="control-label"></label>
                <input asp-for="Gia" class="form-control" id="Gia" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TongTien" class="control-label"></label>
                <input asp-for="TongTien" class="form-control" id="TongTien" readonly />
                <span asp-validation-for="TongTien" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script>
        // Function to format number with dot as thousand separator
        function formatNumberWithDot(x) {
            return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        // Function to calculate total price based on quantity and price
        function calculateTotalPrice() {
            var quantity = document.getElementById("SoLuongNhap").value;
            var price = document.getElementById("Gia").value;
            var totalPrice = parseInt(quantity) * parseFloat(price);

            // Format total price with dot separator
            var formattedTotalPrice = formatNumberWithDot(totalPrice);

            document.getElementById("TongTien").value = formattedTotalPrice; // Set total price with dot separator

        }

        // Call calculateTotalPrice when quantity or price changes
        document.getElementById("SoLuongNhap").addEventListener("input", calculateTotalPrice);
        document.getElementById("Gia").addEventListener("input", calculateTotalPrice);
    </script>
}
