<select name="calc_shipping_provinces" required="">
    <option value="">Tỉnh / Thành phố</option>
</select>
<select name="calc_shipping_district" required="">
    <option value="">Quận / Huyện</option>
</select>
<input class="billing_address_1" name="" type="hidden" value="">
<input class="billing_address_2" name="" type="hidden" value="">

@section Scripts {
    <script src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.1/jquery.min.js'></script>
    <script src='https://cdn.jsdelivr.net/gh/vietblogdao/js/districts.min.js'></script>
    <script>
        $(document).ready(function () {
            function loadSavedAddress() {
                var address_1 = localStorage.getItem('address_1_saved');
                var address_2 = localStorage.getItem('address_2_saved');
                var district = localStorage.getItem('district');

                if (address_1) {
                    $('select[name="calc_shipping_provinces"]').val(address_1).trigger('change');
                    $('input.billing_address_1').val(address_1);
                }
                if (district) {
                    $('select[name="calc_shipping_district"]').html(district);
                    if (address_2) {
                        $('select[name="calc_shipping_district"]').val(address_2);
                        $('input.billing_address_2').val(address_2);
                    }
                }
            }

            $('select[name="calc_shipping_provinces"]').each(function () {
                var $this = $(this),
                    stc = '';
                c.forEach(function (i, e) {
                    e += 1;
                    stc += '<option value="' + i + '">' + i + '</option>';
                });
                $this.html('<option value="">Tỉnh / Thành phố</option>' + stc);
            });

            $('select[name="calc_shipping_provinces"]').on('change', function () {
                var $this = $(this),
                    i = $this.children('option:selected').index() - 1,
                    str = '',
                    r = $this.val();

                if (r != '') {
                    arr[i].forEach(function (el) {
                        str += '<option value="' + el + '">' + el + '</option>';
                    });
                    $('select[name="calc_shipping_district"]').html('<option value="">Quận / Huyện</option>' + str);
                    var address_1 = $this.children('option:selected').text();
                    localStorage.setItem('address_1_saved', address_1);
                } else {
                    $('select[name="calc_shipping_district"]').html('<option value="">Quận / Huyện</option>');
                    localStorage.removeItem('address_1_saved');
                }
                localStorage.setItem('district', $('select[name="calc_shipping_district"]').html());
            });

            $('select[name="calc_shipping_district"]').on('change', function () {
                var $this = $(this),
                    address_2 = $this.children('option:selected').text();
                $('input.billing_address_2').val(address_2);
                localStorage.setItem('address_2_saved', address_2);
                localStorage.setItem('district', $this.html());
            });

            loadSavedAddress();
        });
    </script>
}
