@model IEnumerable<TheThao.Models.BaoHanh>

<section class="container my-5">
    <div class="text-center mb-4">
        <h2 class="display-4">Danh Sách Các Sản Phẩm Đang Được Bảo Hành</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">STT</th>
                    <th scope="col">Tên Sản Phẩm</th>
                    <th scope="col">Ngày Bảo Hành</th>
                    <th scope="col">Ngày Kết Thúc Bảo Hành</th>
                    <th scope="col">Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.MaSanPhamNavigation.Name</td>
                        <td>@item.NgayBaoHanh.Value.ToString("dd/MM/yyyy")</td>
                        <td>@item.NgayKetThucBaoHanh.Value.ToString("dd/MM/yyyy")</td>
                        <td>@item.TrangThai</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
