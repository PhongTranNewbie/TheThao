@model IEnumerable<TheThao.Models.BaoHanh>

<section class="container my-5" style="margin-top: 50px">
    <div class="text-center mb-4">
        <h2 class="display-4">Danh Sách Các Sản Phẩm Đang Được Bảo Hành</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered table-striped">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">STT</th>
                    <th scope="col">Tên Sản Phẩm</th>
                    <th scope="col">Ngày Bảo Hành</th>
                    <th scope="col">Ngày Kết Thúc Bảo Hành</th>
                    <th scope="col">Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    int stt = 1;
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@stt++</th>
                            <td>@item?.MaSerialNavigation?.MaChiTietDonHangNavigation?.MaSanPhamNavigation?.Name ?? "N/A"</td>
                            <td>@item?.NgayBaoHanh</td>
                            <td>@item?.NgayKetThucBaoHanh"</td>
                            <td>
                                <span class="badge badge-@{
                                    switch (item?.TrangThai)
                                    {
                                        case "Active":
                                                @:success
                                            break;
                                        case "Expired":
                                                @:danger
                                            break;
                                        default:
                                                @:secondary
                                            break;
                                    }
                                }">
                                    @item?.TrangThai ?? "N/A"
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No data available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .badge {
        font-size: 1em;
        padding: 0.5em;
    }
</style>
