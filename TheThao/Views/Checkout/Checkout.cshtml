@model TheThao.ViewModels.CheckoutSuccessViewModel

<section class="bg0 p-t-23 p-b-140">

<h3 style="margin-top: 40px; margin-bottom: 10px;">You are finish!</h3>

<p>The information of order:</p>
<p>Id: @Model.DonHang.Id</p>
<p>Create Date: @Model.DonHang.NgayTao</p>
<p>Payment Selection: @Model.DonHang.PhuongPhapThanhToan</p>

    <h3 style="margin-bottom: 10px;">List of products</h3>
@if (Model.ChiTietDonHangs != null && Model.ChiTietDonHangs.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var chiTiet in Model.ChiTietDonHangs)
            {
                <tr>
                    <td>@chiTiet.MaSanPhamNavigation.Name</td>
                    <td>@chiTiet.Gia</td>
                    <td>@chiTiet.SoLuong</td>
                </tr>
            }
        </tbody>
    </table>
}

<p>Total: @Model.TongTien</p>
</section>