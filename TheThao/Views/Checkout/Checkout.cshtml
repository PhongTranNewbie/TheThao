@model TheThao.ViewModels.CheckoutSuccessViewModel

<section class="bg0 p-t-23 p-b-140">

<h3 style="margin-top: 40px; margin-bottom: 10px;">Bạn đã đặt hàng thành công!</h3>
    <h4 style="margin-bottom: 10px;">Chi Tiết Đơn Hàng</h4>

<p>Thông tin đơn hàng:</p>
<p>Id: @Model.DonHang.Id</p>
<p>Ngày Tạo: @Model.DonHang.NgayTao</p>
<p>Payment Selection: @Model.DonHang.PhuongPhapThanhToan</p>

    <h3 style="margin-bottom: 10px;">Danh sách Sản Phẩm</h3>
@if (Model.ChiTietDonHangs != null && Model.ChiTietDonHangs.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Sản Phẩm</th>
                <th>Giá</th>
                <th>Số Lượng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var chiTiet in Model.ChiTietDonHangs)
            {
                <tr>
                    <td>@chiTiet.MaSanPhamNavigation.Name</td>
                    <td>@chiTiet.Gia</td>
                    <td>@chiTiet.SoLuong</td>
                </tr>
            }
        </tbody>
    </table>
}

<p>Tổng Tiền: @Model.TongTien</p>
</section>