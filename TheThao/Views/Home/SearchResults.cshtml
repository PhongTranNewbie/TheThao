@model List<TheThao.Models.SanPham>
@{
    var circles = ViewBag.CircleImages as List<TheThao.Models.Circle>;
    var searchUrl = Url.Action("Search", "Home");
}
<style>
    .product-grid {
        display: flex;
        flex-wrap: wrap;
        /* Ensures divs wrap to the next line */
    }
    /* Màu chữ của các mục trong dropdown */
    .dropdown-item {
        color: black;
        cursor: pointer; /* Đổi màu chữ thành màu xanh */
    }

    .btn-danger.dropdown-toggle {
        background-color: dodgerblue; /* Màu nền là màu xanh */
        color: white; /* Màu chữ là trắng */
        cursor: pointer;
    }
    /* Màu nền của dropdown menu */
    .dropdown-menu {
        background-color: #f8f9fa; /* Đổi màu nền thành màu xám nhạt */
    }

</style>
<script>
    document.getElementById("priceRangeDropdown").addEventListener("change", function () {
        var selectedPriceRange = this.value;
        var keyword = document.querySelector('input[name="keyword"]').value;
        var searchUrlWithParams = "@searchUrl" + "?keyword=" + keyword + "&priceRange=" + selectedPriceRange;
        window.location.href = searchUrlWithParams;

        // Lấy giá trị của option đã chọn
        var selectedOption = this.options[this.selectedIndex].value;

        // Cập nhật giá trị của ô select
        this.value = selectedOption;
    });
</script>

<div class="container py-5">
    <div class="row g-5 align-items-center">
        <div class="col-md-12 col-lg-7">
            <h4 class="mb-3 text-secondary">Dụng cụ thể thao</h4>
            <h1 class="mb-5 display-3 text-primary">Chất lượng và đáng tin cậy</h1>
            <div class="position-relative mx-auto">
                <form method="get" action="@Url.Action("Search", "Home")">
                    <!-- Điều hướng đến action "Search" trong controller "SanPhams" -->
                    <input name="keyword" class="form-control border-2 border-secondary w-75 py-3 px-4 rounded-pill" type="text" placeholder="Search">
                    <button type="submit" class="btn btn-primary border-2 border-secondary py-3 px-4 position-absolute rounded-pill text-white h-100" style="top: 0; right: 25%;">Submit Now</button>
                </form>
            </div>
            <div class="col-md-12 col-lg-5 order-first order-lg-last">
                <div class="position-relative mx-auto mb-4">
                    <select id="priceRangeDropdown" class="form-select border-2 border-secondary py-3 px-4 position-absolute rounded-pill text-white h-100" style="top: 0; right: 0;">
                        <option class="dropdown-item active" value="" selected>Tìm kiếm theo giá</option>
                        <option class="dropdown-item active" value="0-100000">Dưới 100k</option>
                        <option class="dropdown-item active" value="100000-500000">100k - 500k</option>
                        <option class="dropdown-item active" value="500000-1000000">500k - 1 triệu</option>
                        <option class="dropdown-item active" value="1000000-2000000">1 triệu - 2 triệu</option>
                        <option class="dropdown-item active" value="2000000-3000000">2 triệu - 3 triệu</option>
                        <option class="dropdown-item active" value="3000000">Trên 3 triệu</option>
                    </select>
                </div>
            </div>

        </div>
        <div class="col-md-12 col-lg-5 order-first order-lg-last">
            <div id="advertisementCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @foreach (var circle in circles)
                    {
                        @if (circle.IsVisible == true)
                        {
                            <div class="carousel-item @(circle == circles.FirstOrDefault(c => c.IsVisible == true) ? "active" : "")">
                                <img src="@circle.HinhAnh" class="d-block w-100" alt="Circle Image">
                            </div>
                        }
                    }
                </div>


                <button class="carousel-control-prev" type="button" data-bs-target="#advertisementCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#advertisementCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>

        </div>
    </div>
</div>
<div class="btn-group" style="position: relative; top: 0; right: 0;">
    <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Lựa chọn trạng thái
    </button>
    <div class="dropdown-menu">
        <a class="dropdown-item" value="">Tất cả</a>
        <a class="dropdown-item" value="Hết hàng">Hết hàng</a>
        <a class="dropdown-item" value="Bán chạy">Bán chạy</a>
        <a class="dropdown-item" value="Còn hàng">Còn hàng</a>
        <a class="dropdown-item" value="Mới">Mới</a>
    </div>
</div>
<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var product in Model)
        {
            var promotionService = new PromotionService(new TheThaoContext());
            var isPromotionActive = promotionService.HasPromotion(product.Id);
            var promotionDetail = await promotionService.GetPromotionDetails(product.Id);

            <div class="col-md-4 product-grid">
                <div class="product-item">
                    <a href="@Url.Action("ChiTietSanPham", "SanPhams", new { id = product.Id })">
                        <img src="@Url.Content(product.HinhAnh)" alt="Product Image" class="img-fluid">
                        <h5 class="mt-2">@product.Name</h5>
                    </a>

                    @if (isPromotionActive)
                    {
                        // Hiển thị phần trăm giảm giá
                        <p>Giảm: @promotionDetail.PhanTramKhuyenMai%</p>
                        <p>Giá trước khi giảm giá: @string.Format("{0:N0}", product.GiaTruocKhiGiamGia)</p>
                        <p>Giá sau khi giảm giá: @string.Format("{0:N0}", product.Gia)</p>
                    }
                    else
                    {
                        // Hiển thị giá khi không có khuyến mãi
                        <p>Giá: @string.Format("{0:N0}", product.Gia)</p>
                    }

                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="hidden" name="quantity" value="1" /> <!-- Số lượng mặc định -->
                        <button type="submit" class="btn btn-primary" asp-action="AddToCart" asp-controller="Cart" asp-route-id="@product.Id">Thêm vào giỏ hàng</button>
                    </form>
                </div>
            </div>

        }
    }
    else
    {
        <p>No products available.</p>
    }
</div>
@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var priceRangeDropdown = document.getElementById("priceRangeDropdown");
            if (priceRangeDropdown) {
                priceRangeDropdown.addEventListener("change", function () {
                    var selectedPriceRange = this.value;
                    var currentUrl = window.location.href;
                    var updatedUrl;
                    if (currentUrl.includes("priceRange=")) {
                        updatedUrl = currentUrl.replace(/priceRange=[^&]*/, "priceRange=" + selectedPriceRange);
                    } else {
                        updatedUrl = currentUrl + (currentUrl.includes("?") ? "&" : "?") + "priceRange=" + selectedPriceRange;
                    }
                    window.location.href = updatedUrl;
                });
            }
        });
       
        var dropdownItems = document.querySelectorAll(".dropdown-menu .dropdown-item");

        // Lặp qua từng mục và thêm sự kiện click
        dropdownItems.forEach(function (item) {
            item.addEventListener("click", function () {
                // Lấy giá trị của mục đã chọn
                var selectedStatus = this.getAttribute("value");

                // Lấy giá trị từ các phần tử khác (nếu cần)
                var keyword = document.querySelector('input[name="keyword"]').value;
                var priceRange = document.getElementById("priceRangeDropdown").value; // Lấy giá trị của dropdown Price Range (nếu cần)

                // Xây dựng URL tìm kiếm với các tham số đã chọn
                var searchUrlWithParams = "@searchUrl" + "?keyword=" + keyword + "&status=" + selectedStatus + "&priceRange=" + priceRange;

                // Chuyển hướng tới URL tìm kiếm mới
                window.location.href = searchUrlWithParams;
            });
        });

    </script>
}


