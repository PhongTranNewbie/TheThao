@model TheThao.Models.ChiTietHinhAnh


@{
    ViewData["Title"] = "Create";
    Layout = "ExAdm";
}

<h1>Create</h1>

<h4>Chi Tiết Hình Ảnh</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateHA" id="createForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MaSanPham" class="control-label"></label>
                <select asp-for="MaSanPham" class="form-control" asp-items="ViewBag.MaSanPham"></select>
            </div>
            <div class="form-group">
                <label asp-for="HinhAnh" class="control-label"></label>
                <input asp-for="HinhAnh" class="form-control" />
                <span asp-validation-for="HinhAnh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="CreateHA" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

