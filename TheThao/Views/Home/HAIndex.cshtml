@model IEnumerable<TheThao.Models.ChiTietHinhAnh>
@{
    ViewData["Title"] = "Index";
    Layout = "ExAdm";
}
<a asp-action="CreateHA" >Create</a> 
<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Product
            </th>
            <th>
                Image
            </th>
            <th>
                Is Video
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaSanPhamNavigation.Name)
                </td>
                @if (item.IsVideo ?? false)
                {
                    <td>
                        <video src="@item.HinhAnh" alt="Product Video" style="max-width: 100px; max-height: 100px;" controls></video>
                    </td>
                }
                else
                {
                    <td>
                        <img src="@item.HinhAnh" alt="Product Image" style="max-width: 100px; max-height: 100px;" />
                    </td>
                }


                
                
                <td>
                    <a asp-action="EditHA" asp-route-id="@item.Id">Edit</a> |
                </td>
            </tr>
        }
    </tbody>
</table>