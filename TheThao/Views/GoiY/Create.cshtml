@model TheThao.ViewModel.AddProductsToGoiYViewModel

@{
    ViewData["Title"] = "Create SanPhamGoiY";
    Layout = "ExAdm";
}

<h2>Create Recommendation</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="tenGoiY">Recommendation Name</label>
        <input type="text" id="tenGoiY" name="tenGoiY" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="maSanPhams">Products</label>
        <select multiple="multiple" id="maSanPhams" name="maSanPhams" class="form-control" size="10" required>
            @foreach (var item in Model.SanPhams)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>
