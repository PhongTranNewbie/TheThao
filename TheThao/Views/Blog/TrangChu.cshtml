@model IEnumerable<TheThao.Models.Blog>
@{
    Layout = "Client";
	var circles = ViewBag.CircleImages as List<TheThao.Models.Circle>;

}
<style>
	.custom-thumbnail {
		width: 100%;
		height: auto;
	}

</style>
<section class="section-slide">
    <div class="wrap-slick1">
        <div class="slick1">
            @foreach (var circle in circles)
            {
                @if (circle.IsVisible == true)
                {
                    <div class="item-slick1" style="background-size: 100% 100%; background-image: url('@Url.Content(circle.HinhAnh)');">
                        <div class="container h-full">
                            <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                                <div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>


