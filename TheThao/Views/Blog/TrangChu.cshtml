						<!-- Blog item -->
						<div class="blog-item">
							<div class="row">
								<div class="col-md-4">
									<a asp-action="ChiTiet" asp-controller="Blog" asp-route-id="@blog.Id">
										<img class="custom-thumbnail" src="@Url.Content(blog.HinhAnh)" alt="Blog Image" />
									</a>
								</div>
								<div class="col-md-8">
									<div class="blog-content">
										<h4 class="blog-title">
											<a asp-action="ChiTiet" asp-controller="Blog" asp-route-id="@blog.Id" class="ltext-108 cl2 hov-cl1 trans-04">
												@blog.Title
											</a>
										</h4>
										<!-- Add more content if needed, like description, author, date, etc. -->
									</div>
								</div>
							</div>
						</div>
						<!-- End of blog item -->
					}
