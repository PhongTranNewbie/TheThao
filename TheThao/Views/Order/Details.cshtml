@model TheThao.ViewModels.ChiTietDonHangViewModel
<section class="bg0 p-t-23 p-b-140">

<h3 style="margin-top: 50px;">Chi Tiết Đơn Hàng</h3>
<div style=""
<p>Id: @Model.DonHang.Id</p>
<p>Ngày Tạo: @Model.DonHang.NgayTao</p>
<p>Trạng Thái: @Model.DonHang.TrangThai</p>
<p>User Id: @Model.DonHang.UserId</p>

<h2>Danh sách Sản Phẩm</h2>
@if (Model.ChiTietDonHangs != null && Model.ChiTietDonHangs.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Sản Phẩm</th>
                <th>Giá</th>
                <th>Số Lượng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var chiTiet in Model.ChiTietDonHangs)
            {
                <tr>
                    <td>@chiTiet.MaSanPhamNavigation.Name</td>
                    <td>@chiTiet.Gia</td>
                    <td>@chiTiet.SoLuong</td>
                </tr>
            }
        </tbody>
        <p>Tổng tiền: @Model.TongTien</p>
    </table>
}
else
{
    <p>Không có chi tiết đơn hàng phù hợp.</p>
}



</section>  