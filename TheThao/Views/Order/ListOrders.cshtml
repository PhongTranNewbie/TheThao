@using TheThao.Services
@model TheThao.ViewModel.OrdersByStatusViewModel

<section class="bg0 p-t-23 p-b-140">
    <div class="container">
        <h2 class="text-center my-4" style="margin-top: 100px;">List of Orders</h2>
        <div class="row">
            <div class="col-md-4">
                <h3 class="text-center">On Delivery Orders</h3>
                <div class="scrollable-table">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th>ID Order</th>
                                    <th>Create Date</th>
                                    <!-- Additional columns if needed -->
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.OnDeliveryOrders)
                                {
                                    <tr>
                                        <td>@order.Id</td>
                                        <td>@order.NgayTao</td>
                                        <!-- Additional columns if needed -->
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <h3 class="text-center">Paid Orders</h3>
                <div class="scrollable-table">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th>ID Order</th>
                                    <th>Create Date</th>
                                    <!-- Additional columns if needed -->
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.PaidAndAwaitingDeliveryOrders)
                                {
                                    <tr>
                                        <td>@order.Id</td>
                                        <td>@order.NgayTao</td>
                                        <!-- Additional columns if needed -->
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <h3 class="text-center">Waiting for Confirmation Orders</h3>
                <div class="scrollable-table">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th>ID Order</th>
                                    <th>Create Date</th>
                                    <!-- Additional columns if needed -->
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.WaitingForConfirmationOrders)
                                {
                                    <tr>
                                        <td>@order.Id</td>
                                        <td>@order.NgayTao</td>
                                        <!-- Additional columns if needed -->
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .scrollable-table {
        height: 400px; /* Set the desired height */
        overflow-y: auto; /* Add vertical scrollbar */
        overflow-x: hidden; /* Hide horizontal scrollbar */
    }
</style>
