@model List<TheThao.Models.DonHang>

<h2>Danh sách đơn hàng của bạn</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID Đơn hàng</th>
            <th>Ngày tạo</th>
            <th>Trạng thái</th>
            <!-- Thêm các cột khác nếu cần -->
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.NgayTao</td>
                <td>@order.TrangThai</td>
                <td>
                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn-details">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>