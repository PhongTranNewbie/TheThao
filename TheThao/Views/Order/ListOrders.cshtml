        <!-- Các bảng khác tương tự -->

        <div>
            <h2>On Delivery Orders</h2>
            <table class="table">
                <!-- Header -->
                <thead>
                    <tr>
                        <th>ID Order</th>
                        <th>Create date</th>
                        <!-- Thêm các cột khác nếu cần -->
                    </tr>
                </thead>
                <!-- Body -->
                <tbody>
                    @foreach (var order in Model.OnDeliveryOrders)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.NgayTao</td>
                            <!-- Thêm các cột khác nếu cần -->
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div>
            <h2>Paid Orders</h2>
