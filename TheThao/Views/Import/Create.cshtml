@model TheThao.Models.NhapHangViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
    Layout = "ExAdm";
}
<h1>Tạo mới nhập hàng</h1>

<form asp-action="Create">
    <div class="form-group" id="details">
        <!-- Dòng chi tiết nhập hàng mặc định -->
        <label for="NgayNhap">Ngày Nhập:</label>
        <input type="date" id="NgayNhap" name="NgayNhap">

    </div>

    <input type="hidden" id="DanhSachChiTietJson" name="DanhSachChiTietJson" />
    <button type="button" onclick="addProduct()" class="btn btn-primary">Thêm Sản Phẩm</button>
    <button type="submit" class="btn btn-success">Hoàn Thành Đơn Hàng</button>
</form>

<style>
    .product {
        display: flex;
        flex-wrap: wrap;
    }

        .product label,
        .product select,
        .product input {
            flex: 1;
            margin-right: 10px;
        }
</style>



<script>
    var productCount = 0; // Biến này sẽ được sử dụng để tạo chỉ số duy nhất cho mỗi sản phẩm

    function addProduct() {
        // Tăng chỉ số duy nhất cho sản phẩm tiếp theo
        productCount++;

        var detailsDiv = document.getElementById("details");
        var productDiv = document.createElement("div");
        productDiv.className = "product";

        // Thêm chỉ số duy nhất vào id của mỗi phần tử
        productDiv.innerHTML = `
              <label for="MaSanPham${productCount}">Mã Sản Phẩm:</label>
              <select id="MaSanPham${productCount}" name="ChiTietNhapHangs[${productCount - 1}].MaSanPham" class="form-control">
    @foreach (var item in ViewBag.MaSanPham)
    {
                              <option value="@item.Value">@item.Text</option>
    }
          </select>
                  <label for="MaNhaCungCap${productCount}">Nhà cung cấp:</label>
          <select id="MaNhaCungCap${productCount}" name="ChiTietNhapHangs[${productCount - 1}].MaNhaCungCap" class="form-control">
    @foreach (var item in ViewBag.MaNhaCungCap)
    {
                                <option value="@item.Value">@item.Text</option>
    }
                </select>

                <label for="SoLuong${productCount}">Số Lượng:</label>
                <input type="number" id="SoLuong${productCount}" name="ChiTietNhapHangs[${productCount - 1}].SoLuongNhap" class="form-control">
                <label for="Gia${productCount}">Giá:</label>
                <input type="number" id="Gia${productCount}" name="ChiTietNhapHangs[${productCount - 1}].Gia" class="form-control">
              `;
        detailsDiv.appendChild(productDiv);

        // Log dữ liệu của sản phẩm mới vào console để kiểm tra
        console.log("Dữ liệu của sản phẩm mới:");
        console.log({
            index: productCount - 1,
            MaSanPham: document.getElementById(`MaSanPham${productCount}`).value,
            MaNhaCungCap: document.getElementById(`MaNhaCungCap${productCount}`).value,
            SoLuongNhap: document.getElementById(`SoLuong${productCount}`).value,
            Gia: document.getElementById(`Gia${productCount}`).value
        });
    }


</script>



