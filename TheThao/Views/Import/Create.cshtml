@model TheThao.Models.NhapHangViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
}
<h1>Tạo mới nhập hàng</h1>

<form asp-action="Create">
    <div class="form-group" id="details">
        <!-- Dòng chi tiết nhập hàng mặc định -->
        <label for="NgayNhap">Ngày Nhập:</label>
        <input type="date" id="NgayNhap" name="NgayNhap">
        <div class="form-row detail-row">
            <div class="form-group col-md-3">
                <label asp-for="ChiTietNhapHangs[0].MaSanPham" class="control-label"></label>
                <select asp-for="ChiTietNhapHangs[0].MaSanPham" class="form-control" asp-items="ViewBag.MaSanPham"></select>
                <span asp-validation-for="ChiTietNhapHangs[0].MaSanPham" class="text-danger"></span>
            </div>
            <div class="form-group col-md-3">
                <label asp-for="ChiTietNhapHangs[0].MaNhaCungCap" class="control-label"></label>
                <select asp-for="ChiTietNhapHangs[0].MaNhaCungCap" class="form-control" asp-items="ViewBag.MaNhaCungCap"></select>
                <span asp-validation-for="ChiTietNhapHangs[0].MaNhaCungCap" class="text-danger"></span>
            </div>
            <div class="form-group col-md-2">
                <label asp-for="ChiTietNhapHangs[0].SoLuongNhap" class="control-label"></label>
                <input asp-for="ChiTietNhapHangs[0].SoLuongNhap" class="form-control quantity-input" />
                <span asp-validation-for="ChiTietNhapHangs[0].SoLuongNhap" class="text-danger"></span>
            </div>
            <div class="form-group col-md-2">
                <label asp-for="ChiTietNhapHangs[0].Gia" class="control-label"></label>
                <input asp-for="ChiTietNhapHangs[0].Gia" class="form-control price-input" />
                <span asp-validation-for="ChiTietNhapHangs[0].Gia" class="text-danger"></span>
            </div>
            <p>User ID: @userId</p>
        </div>
    </div>
    <input type="hidden" id="DanhSachChiTietJson" name="DanhSachChiTietJson" />
    <button type="button" onclick="addProduct()" class="btn btn-primary">Thêm Sản Phẩm</button>
    <button type="submit" class="btn btn-success">Hoàn Thành Đơn Hàng</button>
</form>

<style>
    .product {
        display: flex;
        flex-wrap: wrap;
    }

        .product label,
        .product select,
        .product input {
            flex: 1;
            margin-right: 10px;
        }
</style>



<script>
    var productCount = 1; // Biến này sẽ được sử dụng để tạo chỉ số duy nhất cho mỗi sản phẩm

    function addProduct() {
        var detailsDiv = document.getElementById("details");
        var productDiv = document.createElement("div");
        productDiv.className = "product";

        // Thêm chỉ số duy nhất vào id của mỗi phần tử
        productDiv.innerHTML = `
                    <label for="MaSanPham${productCount}">Mã Sản Phẩm:</label>
                    <select id="MaSanPham${productCount}" name="ChiTietNhapHangs[${productCount - 1}].MaSanPham" class="form-control">
    @foreach (var item in ViewBag.DanhSachSanPham)
    {
                                    <option value="@item.Value">@item.Text</option>
    }
                    </select>
                    <label for="SoLuong${productCount}">Số Lượng:</label>
                    <input type="number" id="SoLuong${productCount}" name="ChiTietNhapHangs[${productCount - 1}].SoLuongNhap" class="form-control">
                    <label for="Gia${productCount}">Giá:</label>
                    <input type="number" id="Gia${productCount}" name="ChiTietNhapHangs[${productCount - 1}].Gia" class="form-control">
                `;
        detailsDiv.appendChild(productDiv);

        productCount++; // Tăng chỉ số duy nhất cho sản phẩm tiếp theo
    }
</script>



