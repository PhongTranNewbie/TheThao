@model TheThao.Models.Circle

@{
    ViewData["Title"] = "Create";
    Layout = "ExAdm";
}

<h1>Create</h1>

<h4>Thêm hình ảnh</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="HinhAnh" class="control-label"></label>
                <input asp-for="HinhAnh" class="form-control" />
                <span asp-validation-for="HinhAnh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsVisible" class="control-label"></label>
                <div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="IsVisible" id="isVisibleTrue" value="true">
                        <label class="form-check-label" for="isVisibleTrue">Visible</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="IsVisible" id="isVisibleFalse" value="false">
                        <label class="form-check-label" for="isVisibleFalse">Invisible</label>
                    </div>
                </div>
                <span asp-validation-for="IsVisible" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
