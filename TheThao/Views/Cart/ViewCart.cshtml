@model ShoppingCartViewModel
@{
    var sp = ViewBag.SanPham as List<TheThao.Models.SanPham>;
}
@if (TempData["Message"] != null)
{
	<div style="margin-top: 50px;" class="alert alert-info" role="alert">
		@TempData["Message"]
	</div>
}
<!-- Shoping Cart -->
<form class="bg0 p-t-75 p-b-85">
	<div class="container">
		<div class="row">
			<div class="col-lg-10 col-xl-7 m-lr-auto m-b-50">
				<div class="m-l-25 m-r--38 m-lr-0-xl">
					<div class="wrap-table-shopping-cart">
						<table class="table-shopping-cart">
							<tr class="table_head">
								<th class="column-1">Product</th>
								<th class="column-2"></th>
								<th class="column-3">Price</th>
								<th class="column-4">Quantity</th>
								<th class="column-5">Total</th>
								<th class="column-6"></th>
							</tr>

							
								@foreach (var item in Model.CartItems)
								{
								<tr class="table_row">
									
									<td class="column-1">
											@foreach (var image in sp.Where(image => image.Id == item.SanPham.Id))
											{
											<img class="how-itemcart1" src="@Url.Content(image.HinhAnh)" alt="Product Image" onclick="changeMainImage('@Url.Content(image.HinhAnh)')" />
											}
									</td>
									<td class="column-2">@item.SanPham.Name</td>
									<td class="column-3">@item.SanPham.Gia</td>
									<td class="column-4">
										<div class="btn-group btn-group-sm" role="group" aria-label="Basic example">
											<button type="button" class="btn btn-outline-secondary border" onclick="location.href='@Url.Action("DecreaseQuantity", "Cart", new { id = item.SanPham.Id })'"><i class="fs-16 zmdi zmdi-minus"></i></button>
											<button type="button" class="btn btn-outline-secondary border disabled">@item.Quantity</button>
											<button type="button" class="btn btn-outline-secondary border" onclick="location.href='@Url.Action("IncreaseQuantity", "Cart", new { id = item.SanPham.Id })'"><i class="fs-16 zmdi zmdi-plus"></i></button>
										</div>
									</td>

									<td class="column-5">@((item.SanPham.Gia * item.Quantity)?.ToString("C0"))</td>
									<input type="hidden" value="@item.SanPham.Id" />
									<td class="column-6">
										<a asp-controller="Cart" asp-action="RemoveItem" asp-route-id="@item.SanPham.Id" class="btn btn-danger">Delete</a>
									</td>
								</tr>
								}
							


						</table>
					</div>

					<div class="flex-w flex-sb-m bor15 p-t-18 p-b-15 p-lr-40 p-lr-15-sm">


						<div class="flex-c-m stext-101 cl2 size-119 bg8 bor13 hov-btn3 p-lr-15 trans-04 pointer m-tb-10">
							<a asp-action="ClearCart">Delete all</a>
						</div>
					</div>
				</div>
			</div>

			<div class="col-sm-10 col-lg-7 col-xl-5 m-lr-auto m-b-50">
				<div class="bor10 p-lr-40 p-t-30 p-b-40 m-l-63 m-r-40 m-lr-0-xl p-lr-15-sm">
					<h4 class="mtext-109 cl2 p-b-30">
						Cart Totals
					</h4>
					<div class="flex-w flex-t p-t-27 p-b-33">
						<div class="size-208">
							<span class="mtext-101 cl2">
								Total:
							</span>
						</div>

						<div class="size-209 p-t-1">
							<span class="mtext-110 cl2">
								@Model.TotalPrice?.ToString("C0")
							</span>
						</div>
					</div>
					@if (ViewBag.userAddress != null && ((IEnumerable<TheThao.Models.SoDiaChi>)ViewBag.userAddress).Any())
					{
						<h2>Select Address:</h2>
							<select name="selectedAddress" class="form-control">
								@foreach (var address in (IEnumerable<TheThao.Models.SoDiaChi>)ViewBag.userAddress)
								{
								<option value="@address.ThanhPho, @address.QuanHuyen, @address.Xa">@address.ThanhPho, @address.QuanHuyen, @address.Xa</option>
							}
							</select>
					}
					else
					{
						<p>No addresses found for the user.</p>
					}

					<div class="bor8 bg0 m-b-22">
						<label for="paymentSelection">Payment Method:</label>
						<select id="paymentSelection" name="paymentSelection" class="form-control">
							<option value="Offline">Direct Payment</option>
							<option value="Online">Online Payment</option>
						</select>
					</div>
					<button asp-controller="Checkout" asp-action="Checkout" class="flex-c-m stext-101 cl0 size-116 bg3 bor14 hov-btn3 p-lr-15 trans-04 pointer">
						Proceed to Checkout
					</button>
				</div>
			</div>
		</div>

		
	</div>
	</div>
	</div>
	</div>
</form>
