@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Modernize Free</title>
    <link rel="shortcut icon" type="image/png" href="../assets/images/logos/favicon.png" />
    <link rel="stylesheet" href="http://localhost:5098/assets/css/styles.min.css" />
    <!-- Thêm link đến CSS của Bootstrap -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css" rel="stylesheet">

    <!-- Thêm thẻ script để lấy JavaScript của Bootstrap (lưu ý: bạn có thể cần jQuery) -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.tiny.cloud/1/rdy2lktabrps0d79ryog558z1ui6leqjqxthl0hzjyc6hp0h/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: 'textarea#NoiDung',
                    plugins: [
                'a11ychecker', 'advlist', 'advcode', 'advtable', 'autolink', 'checklist', 'markdown',
                'lists', 'link', 'image', 'charmap', 'preview', 'anchor', 'searchreplace', 'visualblocks',
                'powerpaste', 'fullscreen', 'formatpainter', 'insertdatetime', 'media', 'table', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | a11ycheck casechange blocks | bold italic backcolor | alignleft aligncenter alignright alignjustify |' +
                'bullist numlist checklist outdent indent | removeformat | code table help'
        })
    </script>
    
    

</head>

<body>
    <!--  Body Wrapper -->
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full"
         data-sidebar-position="fixed" data-header-position="fixed">
        <!-- Sidebar Start -->
        <aside class="left-sidebar">
            <!-- Sidebar scroll-->
            <div>
                <div class="brand-logo d-flex align-items-center justify-content-between">
                    <a href="/Admin/AdminDashBoard" class="text-nowrap logo-img">
                        <img src="../assets/images/logos/dark-logo.svg" width="180" alt="" />
                    </a>
                    <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
                        <i class="ti ti-x fs-8"></i>
                    </div>
                </div>
                <!-- Sidebar navigation-->
                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                    <ul id="sidebarnav">
                        @if (HttpContextAccessor.HttpContext.Session.GetString("AdminId") != null)
                        {
                            <li class="nav-small-cap">
                                <i class="ti ti-dots nav-small-cap-icon fs-4"></i>
                                <span class="hide-menu">Home</span>
                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" href="/Admin/AdminDashBoard" aria-expanded="false">
                                    <span>
                                        <i class="ti ti-layout-dashboard"></i>
                                    </span>
                                    <span class="hide-menu">Dashboard</span>
                                </a>
                            </li>
                        } else
                        {
                            <li class="nav-small-cap">
                                <i class="ti ti-dots nav-small-cap-icon fs-4"></i>
                                <span class="hide-menu">Home</span>
                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" href="/Admin/EmployeeDashBoard" aria-expanded="false">
                                    <span>
                                        <i class="ti ti-layout-dashboard"></i>
                                    </span>
                                    <span class="hide-menu">Dashboard</span>
                                </a>
                            </li>
                        }
                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-4"></i>
                            <span class="hide-menu">UI COMPONENTS</span>
                        </li>
                        @if (HttpContextAccessor.HttpContext.Session.GetString("AdminId") != null)
                        {
                            <li class="sidebar-item">
                                <a class="sidebar-link" data-bs-toggle="collapse" href="#aMenu" aria-expanded="false" aria-controls="aMenu">
                                    <span>
                                        <i class="ti ti-article"></i>
                                    </span>
                                    <span class="hide-menu">Employee</span>
                                </a>
                                <div class="collapse" id="aMenu">
                                    <ul class="sidebar-dropdown list-unstyled">
                                        <li class="sidebar-subitem">
                                            <a class="sidebar-link" href="/Admin/CreateEmployee">Create Employee</a>
                                        </li>
                                        <li class="sidebar-subitem">
                                            <a class="sidebar-link" href="/Admin/Employee">Staff</a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            }
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/Admin/Customer" aria-expanded="false">
                                <span>
                                    <i class="ti ti-article"></i>
                                </span>
                                <span class="hide-menu">Customer</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" data-bs-toggle="collapse" href="#nhaphangMenu" aria-expanded="false" aria-controls="nhaphangMenu">
                                <span>
                                    <i class="ti ti-article"></i>
                                </span>
                                <span class="hide-menu">Import</span>
                            </a>
                            <div class="collapse" id="nhaphangMenu">
                                <ul class="sidebar-dropdown list-unstyled">
                                    <li class="sidebar-subitem">
                                        <a class="sidebar-link" href="/Import/Create">Import product</a>
                                    </li>
                                    <li class="sidebar-subitem">
                                        <a class="sidebar-link" href="/NhapHangs/Index">The import goods</a>
                                    </li>
                                    <li class="sidebar-subitem">
                                        <a class="sidebar-link" href="/ChiTietNhapHangs/Index">The information of import goods</a>
                                    </li>
                                    <li class="sidebar-subitem">
                                        <a class="sidebar-link" href="/NhaCungCaps/Index">Supplier</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/DonHangs/Index" aria-expanded="false">
                                <span>
                                    <i class="ti ti-shopping-cart"></i>
                                </span>
                                <span class="hide-menu">The order</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/Circle/Index" aria-expanded="false">
                                <span>
                                    <i class="ti ti-article"></i>
                                </span>
                                <span class="hide-menu">Circle</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/Sanphams/Index" aria-expanded="false">
                                <span>
                                    <i class="ti ti-alert-circle"></i>
                                </span>
                                <span class="hide-menu">Product</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/loaiSanPhams/Index" aria-expanded="false">
                                <span>
                                    <i class="ti ti-cards"></i>
                                </span>
                                <span class="hide-menu">Product type</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/Home/HAIndex" aria-expanded="false">
                                <span>
                                    <i class="ti ti-file-description"></i>
                                </span>
                                <span class="hide-menu">The image</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" data-bs-toggle="collapse" href="#phantramMenu" aria-expanded="false" aria-controls="phantramMenu">
                                <span>
                                    <i class="ti ti-article"></i>
                                </span>
                                <span class="hide-menu">Cost of product</span>
                            </a>
                            <div class="collapse" id="phantramMenu">
                                <ul class="sidebar-dropdown list-unstyled">
                                    <li class="sidebar-subitem">
                                        <a class="sidebar-link" href="/PhanTramGiaCas/Index">Percent of product</a>
                                    </li>
                                    <li class="sidebar-subitem">
                                        <a class="sidebar-link" href="/ChiTietPhanTrams/Index">Detail of percent</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" data-bs-toggle="collapse" href="#kmMenu" aria-expanded="false" aria-controls="kmMenu">
                                <span>
                                    <i class="ti ti-article"></i>
                                </span>
                                <span class="hide-menu">Promotion</span>
                            </a>
                            <div class="collapse" id="kmMenu">
                                <ul class="sidebar-dropdown list-unstyled">
                                    <li class="sidebar-subitem">
                                        <a class="sidebar-link" href="/KhuyenMais/Index">Create promotion</a>
                                    </li>
                                    <li class="sidebar-subitem">
                                        <a class="sidebar-link" href="/ChiTietKhuyenMais/Index">Detail of promotion</a>
                                    </li>
                                    
                                </ul>
                            </div>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/Blog/Index" aria-expanded="false">
                                <span>
                                    <i class="ti ti-file-description"></i>
                                </span>
                                <span class="hide-menu">The Blogs</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/Warranty/AdminIndex" aria-expanded="false">
                                <span>
                                    <i class="ti ti-file-description"></i>
                                </span>
                                <span class="hide-menu">Warranty</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/GoiY/Index" aria-expanded="false">
                                <span>
                                    <i class="ti ti-file-description"></i>
                                </span>
                                <span class="hide-menu">Suggest</span>
                            </a>
                        </li>
                        </li>
                        
                    </ul>

                </nav>
                <!-- End Sidebar navigation -->
            </div>
            <!-- End Sidebar scroll-->
        </aside>
        <!--  Sidebar End -->
        <!--  Main wrapper -->
        <div class="body-wrapper">
            <!--  Header Start -->
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-icon-hover" href="javascript:void(0)">
                                <i class="ti ti-bell-ringing"></i>
                                <div class="notification bg-primary rounded-circle"></div>
                            </a>
                        </li>
                    </ul>
                    
                </nav>
            </header>
            <!--  Header End -->
            <div class="container-fluid">
                @RenderBody()
                @RenderSection("Scripts", required: false)
            </div>

            
    <script src="../assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="../assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/sidebarmenu.js"></script>
    <script src="../assets/js/app.min.js"></script>
    <script src="../assets/libs/apexcharts/dist/apexcharts.min.js"></script>
    <script src="../assets/libs/simplebar/dist/simplebar.js"></script>
    <script src="../assets/js/dashboard.js"></script>
           
</body>

</html>