@{
    var httpContextAccessor = ViewContext.HttpContext.RequestServices.GetRequiredService<IHttpContextAccessor>();
    var session = httpContextAccessor.HttpContext.Session;
    var userId = session.GetString("UserId");
    var loggedIn = !string.IsNullOrEmpty(userId);
}

@if (loggedIn)
{
    <text>
        <span>Welcome, @User.Identity.Name!</span>
        <a asp-action="Profile" asp-controller="Login">Profile</a>
        <form asp-action="Logout" asp-controller="Login" method="post" id="logoutForm" class="form-inline">
            <button type="submit" class="btn btn-link">Logout</button>
        </form>
    </text>
}
else
{
    <a asp-action="Login" asp-controller="Login">Login</a>
 
    <a asp-action = "Register" asp-controller = "Login" > Register </a>
}
