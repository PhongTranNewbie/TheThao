@model IEnumerable<TheThao.Models.SanPham>

@{
    Layout = "ExAdm";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table id="table-body" class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>

            <th>
                Price
            </th>
            <th>
                Image
            </th>
            <th>
                Type
            </th>
            <th>
                Status
            </th>
            <th>
                Warranty years
            </th>
            <th>
                Quantity <!-- New column for quantity -->
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>

                <td class="gia-value">
                    @Html.DisplayFor(modelItem => @item.Gia)
                </td>
                <td >
                    <img  src="@item.HinhAnh" alt="Product Image" style="max-width: 100px; max-height: 100px;" />
                </td>


                <td>
                    @Html.DisplayFor(modelItem => item.TheLoai.TenLoaiSanPham)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TrangThai)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SoLuong) <!-- Display the quantity -->
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NamBaoHanh) <!-- Display the quantity -->
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Hàm để định dạng số với dấu chấm hàng nghìn
        function formatNumberWithCommas(number) {
            return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        // Gọi hàm formatNumericColumns khi trang đã được tải
        $(document).ready(function () {
            // Lặp qua từng hàng trong bảng
            $('#table-body tr').each(function () {
                // Lấy giá trị của cột số và loại bỏ phần thập phân ".00"
                var giaValue = $(this).find('.gia-value').text();
                giaValue = giaValue.replace('.00', '');
                // Định dạng số với dấu chấm hàng nghìn
                giaValue = formatNumberWithCommas(giaValue);
                // Gán lại giá trị đã định dạng vào cột số
                $(this).find('.gia-value').text(giaValue);
            });
        });
    </script>
}
<li class="sidebar-item">
    <a class="sidebar-link" href="/Admin/AdminDashBoard" aria-expanded="false">
        <span>
            <i class="ti ti-layout-dashboard"></i>
        </span>
        <span class="hide-menu">Dashboard</span>
    </a>
</li>