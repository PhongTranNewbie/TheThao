@model TheThao.Models.SanPham

@{
    Layout = "ExAdm";
}

<h1>Edit</h1>

<h4>SanPham</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" onsubmit="parseCurrency(this)">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ChiTiet" class="control-label"></label>
                <textarea asp-for="ChiTiet" class="form-control"></textarea>
                <span asp-validation-for="ChiTiet" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gia" class="control-label"></label>
                <input asp-for="Gia" class="form-control" type="number" value="@Model.Gia" oninput="formatCurrency(this)" />  <span asp-validation-for="Gia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HinhAnh" class="control-label"></label>
                <input asp-for="HinhAnh" class="form-control" />
                <span asp-validation-for="HinhAnh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SoLuong" class="control-label"></label>
                <input asp-for="SoLuong" class="form-control" />
                <span asp-validation-for="SoLuong" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TrangThai" class="control-label"></label>
                <select asp-for="TrangThai" class="form-control">
                    <option value="Hết hàng">Hết hàng</option>
                    <option value="Bán chạy">Bán chạy</option>
                    <option value="Còn hàng">Còn hàng</option>
                    <option value="Mới">Mới</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TheLoaiId" class="control-label"></label>
                <select asp-for="TheLoaiId" class="form-control" asp-items="ViewBag.TheLoaiId"></select>
                <span asp-validation-for="TheLoaiId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function formatCurrency(input) {
            // Lấy giá trị nhập vào từ input
            let value = input.value;

            // Xóa tất cả các ký tự không phải số (nếu có)
            value = value.replace(/\D/g, '');

            // Định dạng số thành chuỗi có dấu chấm phân tách hàng nghìn
            let formattedValue = '';
            for (let i = value.length - 1, count = 0; i >= 0; i--) {
                formattedValue = value.charAt(i) + formattedValue;
                count++;
                if (count % 3 === 0 && i !== 0) {
                    formattedValue = '.' + formattedValue;
                }
            }

            // Gán lại giá trị đã định dạng vào input
            input.value = formattedValue;
        }

        // Hàm để loại bỏ dấu chấm khi lưu dữ liệu
        function parseCurrency(form) {
            // Lặp qua từng input trong form để loại bỏ dấu chấm
            for (let i = 0; i < form.elements.length; i++) {
                let input = form.elements[i];
                if (input.type === 'text' && input.name === 'Gia') {
                    let value = input.value;
                    // Xóa tất cả các dấu chấm trong giá trị
                    value = value.replace(/\./g, '');
                    // Gán lại giá trị đã loại bỏ dấu chấm vào input
                    input.value = value;
                }
            }
        }
    </script>
}
