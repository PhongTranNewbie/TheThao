@model IEnumerable<TheThao.Models.BinhLuanViewModel>
@{
    var product = ViewBag.SanPham as TheThao.Models.SanPham;
    var images = ViewBag.ChiTietHinhAnhs as List<TheThao.Models.ChiTietHinhAnh>;
    Layout = "Client";
}
<html>
<head>
    <link rel="stylesheet" href="http://localhost:5098/css/styles.css" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link href="~/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/js/bootstrap.min.js"></script>

    <script type="text/javascript">
        function CRateOut(rate) {
            for (var i = 1; i <= rate; i++) {
                $("$span" + i).attr('class', 'glyphicon-star-empty');
            }
        }
        function CRateOver(rate) {
            for (var i = 1; i <= rate; i++) {
                $("$span" + i).attr('class', 'glyphicon-star');
            }
        }
        function CRateClick(rate) {
            $("#lblRating").val(rate);
            for (var i = 1; i <= rate; i++) {
                $("$span" + i).attr('class', 'glyphicon-star');
            }
        }
        function CRateSelected() {
            var rate = $("#lblRating").val();
            for (var i = 1; i <= rate; i++) {
                $("#span" + i).attr('class', "glyphicon glyphicon-star");
            }
        }
        function VerifyRating() {
            var rate = $("#lblRating").val();
            if (rate == "0") {
                alert("Hãy chọn đánh giá.");
                return false;
            }
        }
    </script>
</head>
</html>
<input type="hidden" value="@product.Id"/>
<div class="container">
    <div class="product-detail-container">
        <div class="row">
            <div class="product-gallery">
                <div class="thumbnail-images">
                    @if (images != null && images.Any(image => image.MaSanPham == product.Id))
                    {
                        @foreach (var image in images.Where(image => image.MaSanPham == product.Id))
                        {
                            <img class="thumbnail" src="@Url.Content(image.HinhAnh)" alt="Product Image" onclick="changeMainImage('@Url.Content(image.HinhAnh)')" />
                        }
                    }
                    else
                    {
                        <p>No additional images available.</p>
                    }
                </div>
            </div>

            <div>
                <div class="product-image">
                    <img id="main-product-image" src="@Url.Content(product.HinhAnh)" alt="Product Image">
                </div>
            </div>
            <div>
                <p>@product.Name</p>    
                <p>@product.ChiTiet</p>
                <p>Còn @product.SoLuong</p>

                <p>Giá: @string.Format("{0:N0}", product.Gia)</p>

                <a class="btn btn-primary" asp-action="AddToCart" asp-controller="Cart" asp-route-id="@product.Id">Add to Cart</a>
            </div>
        </div>
    </div>
</div>

<h2>Show comment</h2>
@if (Model.Any())  // Use Any() to check if Model has any elements
{
    @foreach (var item in Model)
    {
        @Html.Partial("_CommentPartial", item)
        ;
    }
}
else
{
    <p>No comments available for this product.</p>
}

@using (@Html.BeginForm("AddComment", "SanPhams", FormMethod.Post, new { onsubmit = "return VerifyRating()" }))
{
    <textarea rows="6" cols="50" name="productComment" id="txtProductComment"></textarea>
    <div onmouseout="CRateSelected()">
        <span id="span1" onmouseout="CRateOut(1)" onmouseover="CRateOut(1)" onclick="CRateClick(1)" class="glyphicon glyphicon-star-empty"></span>
        <span id="span2" onmouseout="CRateOut(2)" onmouseover="CRateOut(2)" onclick="CRateClick(2)" class="glyphicon glyphicon-star-empty"></span>
        <span id="span3" onmouseout="CRateOut(3)" onmouseover="CRateOut(3)" onclick="CRateClick(3)" class="glyphicon glyphicon-star-empty"></span>
        <span id="span4" onmouseout="CRateOut(4)" onmouseover="CRateOut(4)" onclick="CRateClick(4)" class="glyphicon glyphicon-star-empty"></span>
        <span id="span5" onmouseout="CRateOut(5)" onmouseover="CRateOut(5)" onclick="CRateClick(5)" class="glyphicon glyphicon-star-empty"></span>
    </div>
    <div>
        <input type="hidden" id="lblRating" name="rate" value="0" />
    </div>
    <div>
        <input type="hidden" name="id" value="@product.Id" />
    </div>
    <div>
        <input type="submit" class="btn btn-primary active" name="SaveComment" value="Save Comment" />
    </div>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@section Scripts {
    <script>
        function changeMainImage(imageUrl) {
            $("#main-product-image").attr("src", imageUrl);
        }
    </script>
}

